# Hostinger MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=your_hostinger_database
MYSQL_USER=your_hostinger_database_user
MYSQL_PASSWORD=replace_with_a_strong_password
MYSQL_SSL=false

# Hostinger email or another SMTP mailbox
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@sunxpv.com
SMTP_PASSWORD=replace_with_the_mailbox_password
SMTP_FROM=SunX Website <info@sunxpv.com>
ENQUIRY_NOTIFICATION_EMAIL=info@sunxpv.com
